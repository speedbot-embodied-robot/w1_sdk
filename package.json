{
  "name": "w1-documentation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:verify": "python3 scripts/verify_site.py",
    "docs:format": "prettier --write \"docs/**/*.{md,mts,ts,css}\" \"*.{md,json}\"",
    "docs:format-check": "prettier --check \"docs/**/*.{md,mts,ts,css}\" \"*.{md,json}\""
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "vitepress": "1.6.4"
  }
}
